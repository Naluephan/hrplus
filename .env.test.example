# Environment for the e2e test suites (npm run test:e2e).
#
# Only DB_DATABASE differs from .env: the suites create and delete rows, so
# they must never point at a database anyone else is using. `test/support/env.ts`
# refuses to start unless the database name looks like a test database.
APP_NAME=hr-api
APP_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hr_system_test
JWT_SECRET=
JWT_EXPIRES_IN=1d          # อายุ token เช่น 1d, 12h, 30m
API_PREFIX=api
API_VERSION=v1
TENANT_MODE=single          # single / multi
CENTRAL_API_URL=http://localhost:3000
CENTRAL_API_KEY=
CENTRAL_CLIENT_KEY=
CENTRAL_CLIENT_HOST=localhost:3001|hr
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=central-api
JWT_AUDIENCE=central-clients
CENTRAL_JWT_SECRET=4287b80f113f094a6b2ec64c322e5cf12c395d01655f0b71ffe400d51a31fa5ae56754f8ee587b6dd9d8ee8ec5feca3351f01d0b01254248c180614a855b3655
CENTRAL_JWT_PUBLIC_KEY=./keys/jwt-public.pem
CENTRAL_JWT_ISSUER=central-api
CENTRAL_JWT_AUDIENCE=central-clients
CENTRAL_ALLOW_UNVERIFIED_TOKENS=true

# Numeric base for the per-worker test tenants (worker N uses <base>0N).
# Must be digits: see api-e2e/support/env.ts for why UUIDs break isolation.
TEST_TENANT_ID=9000
